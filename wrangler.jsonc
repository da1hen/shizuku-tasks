{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shizuku-tasks",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shizuku-tasks",
      // Replace the local placeholder with the UUID returned by d1 create before production deployment.
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
