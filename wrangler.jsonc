{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shizuku-tasks",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shizuku-tasks",
      "database_id": "9224cbd0-53c7-4aa3-9b28-f700ef433587"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
